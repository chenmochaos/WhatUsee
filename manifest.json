{
  "manifest_version": 3,
  "name": "WhatUsee · 英语 Box",
  "version": "0.1.5",
  "description": "划选英文，悬停看中文，把想复习的单词和句子放进 Box。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.mymemory.translated.net/*", "https://api.dictionaryapi.dev/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "打开我的 Box"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "match_about_blank": true,
    "run_at": "document_start",
    "js": ["marker-settings.js", "reader.js"],
    "all_frames": true
  }]
}
